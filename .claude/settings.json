{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.testing)",
      "Read(auth.json)",
      "Read(**/node_modules/**)",
      "Read(**/vendor/**)",
      "Edit(.env)",
      "Edit(.env.production)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(php artisan route:list:*)",
      "Bash(php artisan test:*)",
      "Bash(php artisan tinker:*)",
      "Bash(php artisan module:*)",
      "Bash(php artisan modules:sync:*)",
      "Bash(php -l:*)",
      "Bash(./vendor/bin/pint:*)",
      "Bash(composer dump-autoload:*)",
      "Bash(composer install:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run e2e:*)",
      "Bash(npm install:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(ls:*)"
    ],
    "defaultMode": "bypassPermissions"
  }
}
